# Free API key: sign up at https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# SEC EDGAR fair-access policy requires a descriptive User-Agent with contact info.
# Not a secret, but required. Example: "special-spoon you@example.com"
SEC_EDGAR_USER_AGENT=

# Free API key: sign up at https://finnhub.io/register
# Used only by the analyst estimate-revision signal; everything else runs
# without it, and the signal fails soft (its weight redistributes) when absent.
FINNHUB_API_KEY=
